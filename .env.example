# =============================================================================
# Nexora Monitoring Stack - example environment file
# -----------------------------------------------------------------------------
# Copy this file to `.env` (which is git-ignored) and fill in real values.
# NEVER commit a real `.env` file or any secret value.
# =============================================================================

# ---- General -----------------------------------------------------------------
# Logical environment name attached to every metric as an external label.
MONITORING_ENV=production

# ---- Exposed service bind address / host ports -------------------------------
# Bind addresses are separate: Grafana may be reachable from the admin IP while
# Prometheus and Alertmanager stay on loopback (access them via SSH tunnel).
GRAFANA_BIND_ADDRESS=127.0.0.1
PROMETHEUS_BIND_ADDRESS=127.0.0.1
ALERTMANAGER_BIND_ADDRESS=127.0.0.1
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
ALERTMANAGER_PORT=9093
PROMETHEUS_RETENTION_TIME=15d

# ---- Grafana admin -----------------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me_to_a_strong_password

# ---- Prometheus scrape targets ----------------------------------------------
# Node exporter runs as a container on the monitoring host (service name).
NODE_EXPORTER_TARGET=node-exporter:9100
# Backend Rust/Axum /metrics endpoint.
#   Local Docker Desktop : host.docker.internal:3000
#   AWS (app tier)       : 10.30.2.82:3000   <-- replace with your real private IP
NEXORA_APP_METRICS_TARGET=host.docker.internal:3000
# postgres_exporter service name (container-to-container).
NEXORA_DB_EXPORTER_TARGET=postgres-exporter:9187

# ---- Blackbox HTTP probes ----------------------------------------------------
# Public HTTPS frontend (through the existing Nginx / Route 53 / domain).
NEXORA_FRONTEND_PROBE_TARGET=https://nexora.oxytumzone.com
# Backend health endpoint (used for availability + latency probing).
#   Local : http://host.docker.internal:3000/ready
#   AWS   : http://10.30.2.82:3000/ready   <-- replace with your real private IP
NEXORA_BACKEND_PROBE_TARGET=http://host.docker.internal:3000/ready

# ---- PostgreSQL exporter -----------------------------------------------------
# Least-privilege monitoring role created by exporters/postgres-monitor-role.sql
#   Local : postgresql://nexora_monitoring:PASSWORD@host.docker.internal:5432/nexora?sslmode=disable
#   AWS   : postgresql://nexora_monitoring:PASSWORD@10.30.3.195:5432/nexora?sslmode=require
NEXORA_DB_EXPORTER_DSN=postgresql://nexora_monitoring:CHANGE_ME@host.docker.internal:5432/nexora?sslmode=disable

# ---- Alertmanager / Telegram (preferred channel) -----------------------------
# Create a bot with @BotFather, then add it to the target group/channel and
# read the numeric chat id (for example with @getidsbot or getUpdates).
# TELEGRAM_CHAT_ID must be numeric (may be negative for groups). The value below
# is an obvious placeholder and MUST be replaced before alerts will be delivered.
TELEGRAM_BOT_TOKEN=CHANGE_ME_TELEGRAM_BOT_TOKEN
TELEGRAM_CHAT_ID=123456789

# ---- Alertmanager / SMTP (optional secondary channel) ------------------------
SMTP_SMARTHOST=smtp.example.com:587
SMTP_FROM=alertmanager@example.com
SMTP_TO=oncall@example.com
SMTP_AUTH_USERNAME=CHANGE_ME
SMTP_AUTH_PASSWORD=CHANGE_ME
SMTP_REQUIRE_TLS=true

# ---- Alertmanager runtime ----------------------------------------------------
ALERTMANAGER_RESOLVE_TIMEOUT=5m